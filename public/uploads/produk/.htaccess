# Lapisan pertahanan tambahan: folder ini hanya untuk gambar.
# Jangan pernah mengeksekusi skrip dari direktori upload.
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
